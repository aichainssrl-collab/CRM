# MongoDB - Locale
MONGODB_URI=mongodb://localhost:27017

# MongoDB - Cloud Run (Firestore OIDC)
# MONGODB_URI=mongodb://02b5902a-e160-49f2-837f-cf3aa0855a75.europe-west1.firestore.goog:443/crm-aichain-db?loadBalanced=true&tls=true&retryWrites=false&authMechanism=MONGODB-OIDC&authMechanismProperties=ENVIRONMENT:gcp,TOKEN_RESOURCE:FIRESTORE

FIREBASE_PROJECT_ID=aichain-crm-dev
FIREBASE_STORAGE_BUCKET=aichain-crm-dev.appspot.com
GCP_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=crm-tasks
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@aichainsolutions.net
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
DEBUG=true
RATE_LIMIT_PER_MINUTE=60
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Test / seed admin (MAI mettere password nel codice — solo env)
# Usato da backend/test_auth.py per creare l'utente Firebase se non esiste
TEST_ADMIN_EMAIL=admin@aichain.it
TEST_ADMIN_PASSWORD=
